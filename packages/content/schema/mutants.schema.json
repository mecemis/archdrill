{
  "title": "ArchDrill mutants",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "apply": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            }
          },
          "expect": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "invalid": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fails": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "band": {
                "type": "string",
                "enum": ["not-passing", "passing", "strong", "excellent"]
              }
            },
            "required": ["scenario"]
          }
        },
        "required": ["id", "base", "description", "apply", "expect"]
      }
    }
  },
  "required": ["mutants"]
}
