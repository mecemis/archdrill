{
  "title": "ArchDrill catalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "kinds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "traffic-source",
                "load-balancing",
                "health-checking",
                "routing",
                "edge-cache",
                "stateless-compute",
                "volatile-kv",
                "ttl",
                "durable-store",
                "unique-constraint",
                "conditional-write",
                "transactions",
                "secondary-index",
                "range-scan",
                "atomic-increment",
                "id-generation",
                "leases",
                "consensus",
                "rate-limiting",
                "authn",
                "async-buffer",
                "stream-processing",
                "persistent-connections",
                "push-notifications",
                "payments",
                "external",
                "threat-lists"
              ]
            }
          },
          "replicable": {
            "type": "boolean"
          },
          "holdsData": {
            "type": "boolean"
          },
          "shardable": {
            "default": false,
            "type": "boolean"
          },
          "writeScaling": {
            "default": "all-replicas",
            "type": "string",
            "enum": ["all-replicas", "primaries"]
          },
          "inProcess": {
            "default": false,
            "type": "boolean"
          },
          "flavors": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "capabilities": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "traffic-source",
                      "load-balancing",
                      "health-checking",
                      "routing",
                      "edge-cache",
                      "stateless-compute",
                      "volatile-kv",
                      "ttl",
                      "durable-store",
                      "unique-constraint",
                      "conditional-write",
                      "transactions",
                      "secondary-index",
                      "range-scan",
                      "atomic-increment",
                      "id-generation",
                      "leases",
                      "consensus",
                      "rate-limiting",
                      "authn",
                      "async-buffer",
                      "stream-processing",
                      "persistent-connections",
                      "push-notifications",
                      "payments",
                      "external",
                      "threat-lists"
                    ]
                  }
                },
                "managedRedundancy": {
                  "default": false,
                  "type": "boolean"
                },
                "startupSec": {
                  "type": "number",
                  "minimum": 0
                },
                "sizes": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "capacityPerSec": {
                        "default": {},
                        "type": "object",
                        "properties": {
                          "read": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "write": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        }
                      },
                      "memoryGb": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "maxConnections": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "latencyMs": {
                        "type": "object",
                        "properties": {
                          "base": {
                            "type": "number",
                            "minimum": 0
                          },
                          "cv": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": ["base", "cv"]
                      },
                      "costPerHour": {
                        "type": "number",
                        "minimum": 0
                      },
                      "standsFor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "provenance": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "enum": [
                            "capacityPerSec",
                            "latencyMs",
                            "costPerHour",
                            "memoryGb",
                            "maxConnections",
                            "storagePricePerGbMonth",
                            "requestCost",
                            "perKeyCapacityPerSec",
                            "startupSec"
                          ]
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "published": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                                },
                                "note": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": ["published"],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "model": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "basis": {
                                  "default": [],
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                                  }
                                }
                              },
                              "required": ["model"],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": ["label", "latencyMs", "costPerHour"]
                  }
                },
                "defaultSize": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                },
                "storagePricePerGbMonth": {
                  "type": "number",
                  "minimum": 0
                },
                "perKeyCapacityPerSec": {
                  "type": "object",
                  "properties": {
                    "read": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "write": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                },
                "requestCost": {
                  "type": "object",
                  "properties": {
                    "readPerMillion": {
                      "type": "number",
                      "minimum": 0
                    },
                    "writePerMillion": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": ["readPerMillion", "writePerMillion"]
                },
                "notes": {
                  "type": "string"
                },
                "standsFor": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "enum": [
                      "capacityPerSec",
                      "latencyMs",
                      "costPerHour",
                      "memoryGb",
                      "maxConnections",
                      "storagePricePerGbMonth",
                      "requestCost",
                      "perKeyCapacityPerSec",
                      "startupSec"
                    ]
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "published": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                          },
                          "note": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["published"],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "model": {
                            "type": "string",
                            "minLength": 1
                          },
                          "basis": {
                            "default": [],
                            "type": "array",
                            "items": {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                            }
                          }
                        },
                        "required": ["model"],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": ["id", "label", "description"]
            }
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "capabilities",
          "replicable",
          "holdsData",
          "flavors"
        ]
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["price", "quota", "spec", "benchmark", "documentation"]
          },
          "retrieved": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "via": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "title", "url", "publisher", "kind", "retrieved"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "kinds"]
}
