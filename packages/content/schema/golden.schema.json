{
  "title": "ArchDrill golden",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "expect": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": ["minScore"]
      }
    },
    "notPassing": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "problemId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
        },
        "problemVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "architecture": {
          "type": "object",
          "properties": {
            "components": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "kind": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "flavor": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "replicas": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "shards": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  "data": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "entity": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": ["entity"]
                    }
                  },
                  "autoscale": {
                    "type": "object",
                    "properties": {
                      "max": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000
                      },
                      "targetUtilization": {
                        "default": 0.7,
                        "type": "number",
                        "minimum": 0.2,
                        "maximum": 0.95
                      }
                    },
                    "required": ["max"]
                  }
                },
                "required": ["id", "kind", "flavor", "label"]
              }
            },
            "connections": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  "mode": {
                    "default": "sync",
                    "type": "string",
                    "enum": ["sync", "async"]
                  },
                  "policy": {
                    "default": {},
                    "type": "object",
                    "properties": {
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 60000
                      },
                      "retries": {
                        "default": 0,
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10
                      },
                      "backoff": {
                        "default": "exponential",
                        "type": "string",
                        "enum": ["none", "exponential"]
                      },
                      "jitter": {
                        "default": true,
                        "type": "boolean"
                      },
                      "circuitBreaker": {
                        "default": false,
                        "type": "boolean"
                      },
                      "maxRps": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1000000000
                      }
                    }
                  }
                },
                "required": ["id", "from", "to"]
              }
            }
          }
        },
        "flows": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
              },
              "handler": {
                "type": "string",
                "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
              },
              "root": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "steps": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "call"
                        },
                        "target": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "cache.get",
                            "cache.set",
                            "cache.setNegative",
                            "cache.delete",
                            "store.read",
                            "store.insert",
                            "store.insertIfAbsent",
                            "store.update",
                            "store.delete",
                            "queue.publish",
                            "counter.increment",
                            "service.call",
                            "connection.push",
                            "external.notify",
                            "external.charge",
                            "external.refund",
                            "payments.lookup",
                            "external.check",
                            "ids.allocate",
                            "coord.leaseRange"
                          ]
                        },
                        "entity": {
                          "type": "string",
                          "minLength": 1
                        },
                        "ttlSec": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "batchSize": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        },
                        "event": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                        },
                        "coalesce": {
                          "type": "boolean"
                        },
                        "aggregateSec": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3600
                        },
                        "counterShards": {
                          "type": "integer",
                          "minimum": 2,
                          "maximum": 1024
                        },
                        "fireAndForget": {
                          "type": "boolean"
                        },
                        "each": {
                          "type": "string",
                          "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                        },
                        "idempotencyKey": {
                          "type": "boolean"
                        },
                        "exactlyOnce": {
                          "type": "boolean"
                        },
                        "outbox": {
                          "type": "boolean"
                        },
                        "bufferSize": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100000000
                        },
                        "next": {
                          "default": {},
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1
                          },
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                          }
                        }
                      },
                      "required": ["type", "target", "action"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "logic"
                        },
                        "logic": {
                          "type": "string",
                          "enum": [
                            "checkExpiry",
                            "validateUrl",
                            "checkStatus",
                            "hasCustomAlias",
                            "generateRandomCode",
                            "hashUrl",
                            "rehashWithSalt",
                            "encodeBase62",
                            "checkLimit",
                            "checkLocalLimit",
                            "isCelebrity",
                            "obfuscateId"
                          ]
                        },
                        "next": {
                          "default": {},
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1
                          },
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
                          }
                        }
                      },
                      "required": ["type", "logic"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "respond"
                        },
                        "status": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        }
                      },
                      "required": ["type", "status"]
                    }
                  ]
                }
              }
            },
            "required": ["operation", "handler"]
          }
        },
        "decisions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
          }
        },
        "estimates": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
          },
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "layout": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-zA-Z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": ["x", "y"]
          }
        }
      },
      "required": ["schemaVersion", "problemId", "problemVersion", "architecture"]
    }
  },
  "required": ["id", "description", "expect", "attempt"]
}
