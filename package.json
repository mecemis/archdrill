{
  "name": "archdrill",
  "private": true,
  "license": "MIT",
  "description": "Scenario-based system design practice with deterministic simulation and evaluation.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @archdrill/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm typecheck",
    "e2e": "playwright test",
    "report": "pnpm --filter @archdrill/content report",
    "serve": "pnpm build && pnpm --filter @archdrill/web exec vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
