{
  "name": "archdrill",
  "private": true,
  "description": "Scenario-based system design practice with deterministic simulation and evaluation.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @archdrill/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && pnpm typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
